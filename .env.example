# ── Database ────────────────────────────────────────────────────────────────
# On Railway: add a PostgreSQL service and reference it:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pogpt"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-please-generate-a-random-secret"
# Required when running behind a proxy/load balancer (Railway):
AUTH_TRUST_HOST="true"

# ── Secrets encryption (provider API keys at rest) ──────────────────────────
# Generate with: openssl rand -hex 32
# Falls back to AUTH_SECRET if unset (set it explicitly in production).
APP_ENCRYPTION_KEY=""

# ── Bootstrap admin (optional) ──────────────────────────────────────────────
# If set and no users exist yet, this admin account is created on startup.
# Otherwise, the first visitor to /setup creates the initial admin account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# ── Branding ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="PO-GPT"
