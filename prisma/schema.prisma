generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum ProviderType {
  ANTHROPIC
  OPENAI
  GOOGLE
  LOCAL
}

enum ModelKind {
  CHAT
  EMBEDDING
}

enum DocStatus {
  PROCESSING
  READY
  ERROR
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  passwordHash      String
  role              Role     @default(USER)
  active            Boolean  @default(true)
  /// Monthly token budget. null = inherit global default; 0 = unlimited.
  monthlyTokenLimit Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  chats    Chat[]
  projects Project[]
  usage    UsageRecord[]
}

model AppSettings {
  id                       Int      @id @default(1)
  /// Global default monthly token budget per user. 0 = unlimited.
  defaultMonthlyTokenLimit Int      @default(0)
  updatedAt                DateTime @updatedAt
}

model Provider {
  id         String       @id @default(cuid())
  name       String
  type       ProviderType
  /// AES-256-GCM encrypted API key (nullable for LOCAL endpoints without auth)
  apiKeyEnc  String?
  /// Last 4 characters of the key, for display
  apiKeyHint String?
  /// Base URL for LOCAL (OpenAI-compatible) endpoints, e.g. http://ollama:11434/v1
  baseUrl    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  models LlmModel[]
}

model LlmModel {
  id                 String    @id @default(cuid())
  providerId         String
  provider           Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /// Provider-side model identifier, e.g. "claude-sonnet-5"
  modelKey           String
  displayName        String
  kind               ModelKind @default(CHAT)
  enabled            Boolean   @default(true)
  isDefault          Boolean   @default(false)
  /// USD per 1M input tokens (for cost estimation)
  inputPricePerMTok  Float?
  /// USD per 1M output tokens (for cost estimation)
  outputPricePerMTok Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  chats Chat[]

  @@unique([providerId, modelKey])
}

model Project {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  description  String   @default("")
  /// Custom instructions injected into every chat in this project
  instructions String   @default("")
  /// Free-form project memory, editable by the user
  memory       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chats     Chat[]
  documents Document[]

  @@index([ownerId, updatedAt])
}

model Document {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  sizeBytes Int
  status    DocStatus @default(PROCESSING)
  /// True when all chunks have vector embeddings (semantic search available)
  embedded  Boolean   @default(false)
  error     String?
  createdAt DateTime  @default(now())

  chunks DocumentChunk[]

  @@index([projectId])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  seq        Int
  content    String
  // NOTE: an "embedding vector(1536)" column is added out-of-band at startup
  // when the pgvector extension is available (see src/lib/bootstrap.ts).
  // All vector reads/writes go through raw SQL.

  @@index([documentId])
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  modelId   String?
  model     LlmModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
}

model Message {
  id           String   @id @default(cuid())
  chatId       String
  chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role         String
  /// UIMessage parts (AI SDK), stored as JSON
  parts        Json
  modelKey     String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([chatId, createdAt])
}

model UsageRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId       String?
  modelKey     String
  providerType String
  inputTokens  Int
  outputTokens Int
  /// Estimated cost in USD based on model pricing at time of use
  estCostUsd   Float    @default(0)
  /// Month bucket in "YYYY-MM" format for fast aggregation
  month        String
  createdAt    DateTime @default(now())

  @@index([userId, month])
  @@index([month])
}
